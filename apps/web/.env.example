# Ollalink marketing site environment variables
# Copy this file to .env.local and fill in real values for local development.

# Required: Convex deployment URL (used by the client provider)
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Optional: links to the dashboard and booking
NEXT_PUBLIC_APP_URL=https://app.ollalink.io
NEXT_PUBLIC_CAL_LINK=

# OpenPanel analytics
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=
