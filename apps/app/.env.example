# Ollalink dashboard environment variables
# Copy this file to .env.local and fill in real values for local development.

# Required: Convex deployment URL (from `npx convex dev` or `npx convex deploy`)
NEXT_PUBLIC_CONVEX_URL=https://your-convex-deployment.convex.cloud

# Resend (or use SMTP settings in your Convex dashboard for auth emails)
RESEND_API_KEY=

# OpenPanel analytics
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=

# Sentry / GlitchTip error reporting
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Optional: app metadata and redirects
NEXT_PUBLIC_APP_URL=https://ollalink.io
NEXT_PUBLIC_CAL_LINK=

# For local Next.js dev server
PORT=3000
